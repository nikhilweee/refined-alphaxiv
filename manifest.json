{
  "manifest_version": 3,
  "name": "Refined alphaXiv",
  "version": "0.1.0",
  "description": "Switch to arXiv and highlight selected text automatically.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://alphaxiv.org/*", "https://www.alphaxiv.org/*"],
    "js": ["content.js"],
    "css": ["content.css"]
  }]
}
